{
  "name": "@page-composer/nuxt",
  "version": "0.5.0",
  "description": "Nuxt module for Page Composer. Registers the ComposedPage renderer globally with SSR, injects the styles, and adds composables.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "homepage": "https://github.com/virgilvox/vue-page-composer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virgilvox/vue-page-composer.git",
    "directory": "packages/nuxt"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "page-builder",
    "page-composer",
    "ssr"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.6",
    "@page-composer/vue": "workspace:^"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/test-utils": "^4.0.3",
    "nuxt": "^4.4.6"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
